# --- Frontend (web) ---------------------------------------------------------
# Copy to .env.local for local development.

# "mock": browser-only fixtures, nothing is sent to a server (default in `next dev`).
# "live": use the Express API through the Next.js BFF (default in production builds).
NEXT_PUBLIC_API_MODE=mock

# Server-only (never exposed to the browser). Origin of the Express API, used by the
# BFF route handlers in src/app/api. Local: http://localhost:4000
# Docker Compose (web container): http://api:4000
# Vercel / production: https://py.telaahkarier.com (no trailing path)
API_INTERNAL_URL=http://localhost:4000

# Server-only. Must equal INTERNAL_API_KEY on the API. Sent by the BFF as `x-internal-key`.
INTERNAL_API_KEY=

# Optional: self-host the Pyodide runtime instead of using the jsDelivr CDN.
# NEXT_PUBLIC_PYODIDE_INDEX_URL=/pyodide/
