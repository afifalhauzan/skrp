# Docker Compose / VPS environment. Copy to `.env` (never commit it) and fill in real values.
# `docker compose` reads this file automatically.

# --- PostgreSQL (container `db`) -------------------------------------------
POSTGRES_USER=skrp
# Use a long random value. Keep it URL-safe (letters/digits/-/_) because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=
POSTGRES_DB=skrp

# --- API (container `api`) --------------------------------------------------
# Shared secret between the Next.js BFF and the API (sent as `x-internal-key`).
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=
# Enables roster administration endpoints (`x-admin-key`). Leave empty to keep them disabled.
ADMIN_API_KEY=
# Comma-separated browser origins allowed by CORS. Empty = no CORS headers, which is correct
# when only the Next.js BFF (server-to-server) calls the API.
CORS_ORIGINS=
LOG_LEVEL=info
# Number of reverse proxies in front of the API (Caddy/nginx = 1).
TRUST_PROXY=1
# Host port mapping for the API. Loopback by default; the TLS proxy on the VPS forwards here.
API_BIND=127.0.0.1
API_PORT=4000

# --- Optional web container (`--profile web`) -------------------------------
WEB_BIND=127.0.0.1
WEB_PORT=3000

# --- AI evaluation and hints (Gemini via LangChain.js) -----------------------
# Server-side only. Without a key the AI endpoints answer AI_NOT_CONFIGURED and students
# cannot complete stages. Never expose these through the web app.
GEMINI_API_KEY=
# Defaults to gemini-2.5-flash when empty.
GEMINI_MODEL=
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=1
# Keep "true" in production: stage completion requires an evaluation of the current work.
REQUIRE_EVALUATION_FOR_PROGRESS=true
# Minimum raw score (of 40) a stage needs before the student may continue. 0 = no minimum.
STAGE_MIN_SCORE=20
# Provisional, unvalidated: ratio 0-1 enables skipping Case 2 after a strong Case 1. Empty = never.
ROUTING_SKIP_MIN_RATIO=

# For local development without Docker see api/.env.example and web/.env.example.
