{
  "name": "skrp",
  "version": "0.2.0",
  "private": true,
  "description": "PyScaffold monorepo: Next.js frontend (web), Express + Prisma backend (api), shared contracts (packages/shared).",
  "scripts": {
    "dev:web": "pnpm --filter @skrp/web dev",
    "dev:api": "pnpm --filter @skrp/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=20"
  }
}
