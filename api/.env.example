# API environment for local development (copy to api/.env). Never commit real secrets.

NODE_ENV=development
PORT=4000

# Local Postgres. Inside Docker Compose the host is `db`, not `localhost` (Compose sets it for you).
DATABASE_URL=postgresql://skrp:skrp@localhost:5432/skrp?schema=public

# Optional in development, REQUIRED when NODE_ENV=production (min 16 chars).
# The Next.js BFF sends the same value as `x-internal-key`.
INTERNAL_API_KEY=

# Enables /api/students (list/create/import/update). Disabled when empty. Min 16 chars.
ADMIN_API_KEY=

# Comma-separated allowed browser origins. Leave empty if only the BFF calls the API.
CORS_ORIGINS=

LOG_LEVEL=info

# AI evaluation and hints (Gemini via LangChain.js). Server-side only: never put these in
# web/.env or any NEXT_PUBLIC_* variable. Without a key the AI endpoints answer
# AI_NOT_CONFIGURED and students cannot complete stages.
GEMINI_API_KEY=
# Defaults to gemini-2.5-flash when empty.
GEMINI_MODEL=
# Per-attempt provider timeout (ms) and extra attempts for transient failures.
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=1
# Stage completion requires an evaluation of the current work. Keep "true" in production.
REQUIRE_EVALUATION_FOR_PROGRESS=true
# Minimum raw score (of 40) a stage needs before the student may continue. 0 = no minimum.
STAGE_MIN_SCORE=20
# Provisional routing override: set a ratio 0-1 (e.g. 0.8) to allow skipping Case 2 after a
# strong Case 1. Empty = never skip. Unvalidated; development only.
ROUTING_SKIP_MIN_RATIO=
TRUST_PROXY=0
