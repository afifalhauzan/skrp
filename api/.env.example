# API environment for local development (copy to api/.env). Never commit real secrets.

NODE_ENV=development
PORT=4000

# Local Postgres. Inside Docker Compose the host is `db`, not `localhost` (Compose sets it for you).
DATABASE_URL=postgresql://skrp:skrp@localhost:5432/skrp?schema=public

# Optional in development, REQUIRED when NODE_ENV=production (min 16 chars).
# The Next.js BFF sends the same value as `x-internal-key`.
INTERNAL_API_KEY=

# Enables /api/students (list/create/import/update). Disabled when empty. Min 16 chars.
ADMIN_API_KEY=

# Comma-separated allowed browser origins. Leave empty if only the BFF calls the API.
CORS_ORIGINS=

LOG_LEVEL=info
TRUST_PROXY=0
